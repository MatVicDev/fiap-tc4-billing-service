# Copie para .env. JWT_SECRET deve ser idêntico nos três microsserviços e na Lambda de CPF.
JWT_SECRET=troque-esta-chave-por-uma-secreta-de-pelo-menos-32-caracteres
# Mercado Pago: "fake" (checkout simulado) ou "mercadopago" (API real)
MERCADOPAGO_MODO=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública que o Mercado Pago chamará (ex.: https://<seu-túnel>/webhooks/mercadopago)
MERCADOPAGO_NOTIFICATION_URL=
